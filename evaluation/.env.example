# Endpoint website (jalankan `npm run dev` di web/ dengan EVAL_MODE=true)
EVAL_ENDPOINT=http://localhost:3000/api/chat
# Juri RAGAS lewat OpenRouter
OPENROUTER_API_KEY=
JUDGE_MODEL=anthropic/claude-sonnet-5.5
# Batas token keluaran per panggilan juri; OpenRouter menolak jika melebihi sisa kredit
JUDGE_MAX_TOKENS=1024
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
